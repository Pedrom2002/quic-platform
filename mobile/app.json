{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "scheme": "quicapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6F4FE"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pt.quic.app"
    },
    "android": {
      "package": "pt.quic.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/PLACEHOLDER_PROJECT_ID"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-video",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Precisamos de acesso à câmara para ler o código QR dos bilhetes.",
          "microphonePermission": "Esta app não grava áudio. A permissão é pedida pela biblioteca de câmara mas nunca é usada."
        }
      ],
      "expo-secure-store",
      "@sentry/react-native/expo"
    ]
  }
}
