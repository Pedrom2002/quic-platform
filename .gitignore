# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.e2e.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# playwright
test-results/
playwright-report/
.playwright/

# AI / tooling artifacts
.playwright-mcp/
.superpowers/
docs/superpowers/

# supabase CLI local state
/supabase/.temp/
/supabase/.branches/
.worktrees/
.claude/settings.local.json
.claude/hookify.*.local.md

# scratch/dump files at repo root (not app assets, keep out of context/tracking)
/*.mp4
/*.mov
/*.pdf
/*_screenshot.*
UsersP02*/
