{
  "name": "quic-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run audit:deps && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "audit:deps": "npm audit --omit=dev --audit-level=critical",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > types/database.ts",
    "db:migrate": "node scripts/apply-pending-migrations.mjs",
    "db:migrate:dry": "node scripts/apply-pending-migrations.mjs --dry-run"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
