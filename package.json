    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10",
    "eslint-config-next": "^16.3.3",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "postgres": "^3.4.9",
