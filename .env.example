# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # never expose client-side
SUPABASE_PROJECT_ID=your-project-id               # used by: npm run db:types

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app   # no trailing slash

# ─── Auth ──────────────────────────────────────────────────────────────────────
# generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-min-32-chars

# ─── Vercel Blob ───────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── Email (Brevo) ─────────────────────────────────────────────────────────────
BREVO_API_KEY=xkeysib-...
EMAIL_FROM=noreply@yourdomain.com

# ─── SMS (Brevo) ───────────────────────────────────────────────────────────────
# optional - sender name shown on client's phone (max 11 chars, alphanumeric)
BREVO_SMS_SENDER=QUIC

# ─── Resend webhooks ───────────────────────────────────────────────────────────
# optional — only needed if you use Resend delivery webhooks
RESEND_WEBHOOK_SECRET=whsec_...

# ─── QStash (Upstash) ──────────────────────────────────────────────────────────
# optional — only needed if you use QStash for async job dispatch
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ─── Redis (Upstash) ───────────────────────────────────────────────────────────
# optional — not required by default
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── AI (Google Gemini) ────────────────────────────────────────────────────────
# optional — AI features degrade gracefully without this
GEMINI_API_KEY=

# ─── Portal ────────────────────────────────────────────────────────────────────
# optional — overrides the portal base URL (defaults to NEXT_PUBLIC_APP_URL)
NEXT_PUBLIC_PORTAL_URL=

# ─── Sentry (error monitoring) ──────────────────────────────────────────────────
# optional — without SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN, Sentry stays inactive
# (no-op) and nothing is sent. Set both to activate server+client monitoring.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# optional — only needed to upload source maps during build (CI)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
