# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # never expose client-side
SUPABASE_PROJECT_ID=your-project-id               # used by: npm run db:types

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app   # no trailing slash

# ─── Auth ──────────────────────────────────────────────────────────────────────
# generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-min-32-chars

# ─── Vercel Blob ───────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── Email (Brevo) ─────────────────────────────────────────────────────────────
BREVO_API_KEY=xkeysib-...
EMAIL_FROM=noreply@yourdomain.com

# ─── Resend webhooks ───────────────────────────────────────────────────────────
# optional — only needed if you use Resend delivery webhooks
RESEND_WEBHOOK_SECRET=whsec_...

# ─── QStash (Upstash) ──────────────────────────────────────────────────────────
# optional — only needed if you use QStash for async job dispatch
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ─── Redis (Upstash) ───────────────────────────────────────────────────────────
# optional — not required by default
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── AI (Google Gemini) ────────────────────────────────────────────────────────
# optional — AI features degrade gracefully without this
GEMINI_API_KEY=

# ─── Portal ────────────────────────────────────────────────────────────────────
# optional — overrides the portal base URL (defaults to NEXT_PUBLIC_APP_URL)
NEXT_PUBLIC_PORTAL_URL=
# optional — kept for seed script compatibility; not used at runtime
PORTAL_JWT_SECRET=
