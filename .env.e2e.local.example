# E2E test credentials — copy to .env.e2e.local (gitignored) and fill in.
# See e2e/artist-portal.spec.ts for how these are used.

# Portal token of an artist seeded for E2E (artists.portal_token).
# Tests expect one visible agenda item, one clipping, and two assets
# (section='content' and section='document').
E2E_ARTIST_PORTAL_TOKEN=

# Reserved for a future event-cliping E2E spec (events.portal_token).
E2E_EVENT_PORTAL_TOKEN=

# Dashboard login for a test-only team member (role=admin) in an isolated org.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# Base URL to test against. Omit to auto-start `npm run dev` on localhost:3000.
# E2E_BASE_URL=https://staging.quic.pt
